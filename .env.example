STUDIO_API_KEY=
STUDIO_BASE_URL=https://api.openai.com/v1
STUDIO_MODEL=gpt-4o-mini
# On Vercel, leave STUDIO_API_KEY empty to use AI Gateway via VERCEL_OIDC_TOKEN.
STUDIO_MAX_USD=2
STUDIO_MAX_TOKENS=800
STUDIO_USD_PER_1K_IN=0.005
STUDIO_USD_PER_1K_OUT=0.015
STUDIO_TIMEOUT_S=30
# Set to 1 to skip the upstream model and return canned artefacts.
STUDIO_MOCK=0
